# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Signal threshold: minimum sample count before a metric is surfaced on the
# dashboard rather than suppressed as "not enough data".
SIGNAL_MIN_SAMPLE_COUNT=10

# CSFloat ingestion
CSFLOAT_API_KEY=
# Respect per-endpoint rate limits from response headers; this is a starting default.
CSFLOAT_POLL_INTERVAL_SECONDS=60
# Tracked listings rechecked by id each poll, to catch price changes, sales and
# delistings. With the 60s poll that's ~29k requests/day of the by-id endpoint's
# observed 50k/day limit (separate from the feed's own, much smaller, limit).
CSFLOAT_RECHECK_PER_POLL=20

# Skinport ingestion — client id/secret from your Skinport account settings (API).
SKINPORT_ID=
SKINPORT_SECRET=
# Skinport caches /v1/items for 5 minutes and allows 8 requests / 5 minutes.
SKINPORT_POLL_INTERVAL_SECONDS=300
# Unchanged items are re-published this often anyway, so they don't expire
# (see LISTING_STALE_AFTER_HOURS). Must stay well under it.
SKINPORT_RECONFIRM_HOURS=6

# Consolidator: an active listing no ingester has re-observed for this long is
# marked 'expired' — mainly listings an ingester lost track of on restart.
LISTING_STALE_AFTER_HOURS=48

# Postgres — defaults below match docker-compose.yml for local dev.
# Port 5433 (not the standard 5432) to sidestep a possible pre-existing local
# Postgres install on the default port.
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cs2_market

# Kafka-compatible broker (Redpanda locally — see docker-compose.yml)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# How often analysis/scheduler.py recomputes trend/arbitrage/underpriced_listing
ANALYSIS_RECOMPUTE_INTERVAL_SECONDS=300
