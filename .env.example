# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Signal threshold: minimum sample count before a metric is surfaced on the
# dashboard rather than suppressed as "not enough data".
SIGNAL_MIN_SAMPLE_COUNT=10

# CSFloat ingestion
CSFLOAT_API_KEY=
# Respect per-endpoint rate limits from response headers; this is a starting default.
CSFLOAT_POLL_INTERVAL_SECONDS=60

# Postgres — defaults below match docker-compose.yml for local dev.
# Port 5433 (not the standard 5432) to sidestep a possible pre-existing local
# Postgres install on the default port.
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cs2_market

# Kafka-compatible broker (Redpanda locally — see docker-compose.yml)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
